---
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';
import { profile } from '../content/home';
import Arrow from '../components/Arrow.astro';
import NotebookRow from '../components/NotebookRow.astro';
import NovaLab from '../components/NovaLab.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Beksultan Baimagambetov — CTO and co-founder of NovaLab. Backend architecture, infrastructure, and full-stack engineering." />
    <meta name="theme-color" content="#F7F5EF" />
    <title>Beksultan Baimagambetov — Engineering Notebook</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="name-link" href="#main"><span class="name-mark" aria-hidden="true"></span>{profile.name}</a>
        <nav aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href={profile.github}>GitHub <Arrow diagonal /></a>
        </nav>
      </header>

      <main id="main" tabindex="-1">
        <NotebookRow label="Introduction" class="hero">
          <p class="descriptor">{profile.descriptor}</p>
          <h1><span>I turn unfamiliar </span><span>problems into </span><span>working systems.</span></h1>
          <p class="introduction">{profile.introduction}</p>
          <div class="hero-actions">
            <a class="primary-link" href="#work">Explore my work <Arrow /></a>
            <a class="text-link" href={profile.github}>GitHub <Arrow diagonal /></a>
          </div>
        </NotebookRow>
        <NovaLab />
      </main>

      <footer class="site-footer">
        <p>{profile.name}</p>
        <a href={profile.github}>Find me on GitHub <Arrow diagonal /></a>
      </footer>
    </div>
  </body>
</html>
